{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "default_agent": "plan",
  "autoupdate": false,
  "permission": {
    "skill": {
      "*": "allow",
    },
    "bash": {
      "rm -rf *": "ask",
      "git commit": "deny",
      "git rebase": "deny",
      "git push": "deny",
      "git pull": "ask",
      "git merge": "deny",
      "git stash": "ask",
      "git reset": "deny"
    }
  },
}
